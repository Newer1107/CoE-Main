generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
  INDUSTRY_PARTNER
}

enum ProblemType {
  OPEN
  INTERNSHIP
  FACULTY_INTERNSHIP
}

enum ProblemApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum GrantCategory {
  GOVT_GRANT
  SCHOLARSHIP
  RESEARCH_FUND
  INDUSTRY_GRANT
}

enum EventMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum ProblemMode {
  OPEN
  CLOSED
}

enum ProblemStatus {
  OPENED
  CLOSED
  ARCHIVED
}

enum ClaimStatus {
  IN_PROGRESS
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REVISION_REQUESTED
  REJECTED
}

enum EventStatus {
  UPCOMING
  ACTIVE
  JUDGING
  CLOSED
}

enum ImpersonationStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum ApplicationStatus {
  SUBMITTED
  SELECTED
  REJECTED
}

enum InternshipTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum InternshipDocumentType {
  FILE
  LINK
}

enum MeetingRecurrenceType {
  NONE
  WEEKLY
}

enum NotificationType {
  TASK_ASSIGNED
  MESSAGE_POSTED
  MEETING_SCHEDULED
  DOCUMENT_UPLOADED
  HOSTING_REQUEST
  EVENT_UPDATE
}

enum HostingRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum DatabaseType {
  NONE
  MYSQL
  POSTGRESQL
  MONGODB
}

enum TicketType {
  FACILITY_BOOKING
  HACKATHON_SELECTION
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum MemberAttendanceStatus {
  NOT_PRESENT
  PRESENT
}

model User {
  id         Int        @id @default(autoincrement())
  name       String
  nameChangedAt DateTime? // one-time student name change (locked forever after)
  email      String     @unique
  phone      String?
  password   String
  role       Role
  uid        String?
  googleId   String?    @unique
  isVerified Boolean    @default(false)
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookings                    Booking[]
  newsPosts                   NewsPost[]
  grants                      Grant[]
  events                      Event[]
  announcements               Announcement[]
  problemsCreated             ClaimMember[]
  hackathonsCreated           HackathonEvent[]              @relation("HackathonCreator")
  problemsAuthored            Problem[]                     @relation("ProblemAuthor")
  studentProfile              StudentProfile?
  facultyProfile              FacultyProfile?
  applications                Application[]
  tickets                     Ticket[]
  hackathonInterests          HackathonInterest[]
  certificates                Certificate[]
  programsCreated             InnovationProgram[]           @relation("ProgramCreator")
  programInterests            ProgramInterest[]
  uploadedSessionDocuments    SessionDocument[]             @relation("SessionDocumentUploader")
  sessionUploadLockUpdates    HackathonSessionUploadLock[]  @relation("SessionUploadLockUpdater")
  attendanceMarkedEntries     TicketAttendance[]            @relation("AttendanceMarker")
  judgeAssignments            JudgeAssignment[]
  feedbackGiven               EventFeedback[]
  coordinatedEvents           HackathonEvent[]              @relation("EventCoordinator")
  rubricScores              RubricScore[]
  eventCoordinatorRoles       EventCoordinator[]
  attendanceEntries           TicketAttendance[]            @relation("AttendanceParticipant")
  internshipTasks             InternshipTask[]              @relation("InternshipTaskAssignee")
  internshipMessages          InternshipMessage[]           @relation("InternshipMessageSender")
  internshipDocuments         InternshipDocument[]          @relation("InternshipDocumentUploader")
  notifications               Notification[]
  hostingRequests             HostingRequest[]              @relation("HostingRequestStudent")
  reviewedHostingRequests     HostingRequest[]              @relation("HostingRequestReviewer")
  hostingRequestStatusChanges HostingRequestStatusHistory[] @relation("HostingRequestStatusChangedBy")
  industryId                  Int?
  industry                    Industry?                     @relation(fields: [industryId], references: [id], onDelete: NoAction)
  departmentId                Int?
  department                  Department?                   @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  isCoordinator               Boolean                       @default(false)
  erpPasswordEnc              String?                       @map("erp_password_enc")
  erpPasswordSetAt            DateTime?                     @map("erp_password_set_at")
  opportunitiesCreated        Opportunity[]
  opportunityInterests        OpportunityInterest[]
  learningResourcesCreated    LearningResource[]

  @@index([googleId])
  @@index([industryId])
  @@map("users")
}

model Industry {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  users     User[]
  problems  Problem[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("industries")
}

model Problem {
  id                  Int                   @id @default(autoincrement())
  title               String
  description         String                @db.Text
  isCustom            Boolean               @default(false) // open-innovation submission — hidden from the student catalogue
  tags                String?
  isIndustryProblem   Boolean               @default(false)
  industryName        String?
  problemType         ProblemType           @default(OPEN)
  approvalStatus      ProblemApprovalStatus @default(APPROVED)
  mode                ProblemMode           @default(OPEN)
  status              ProblemStatus         @default(CLOSED)
  createdById         Int
  createdBy           User                  @relation("ProblemAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  industryId          Int?
  industry            Industry?             @relation(fields: [industryId], references: [id], onDelete: NoAction)
  eventId             Int?
  event               HackathonEvent?       @relation(fields: [eventId], references: [id], onDelete: NoAction)
  claims              Claim[]
  supportDocumentKey  String?
  difficulty          String?
  sdgTags             Json?
  departmentId        Int?
  department          Department?           @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  applications        Application[]
  internshipTasks     InternshipTask[]      @relation("InternshipProblemTasks")
  internshipMessages  InternshipMessage[]   @relation("InternshipProblemMessages")
  internshipMeetings  InternshipMeeting[]   @relation("InternshipProblemMeetings")
  internshipDocuments InternshipDocument[]  @relation("InternshipProblemDocuments")
  questions           ProblemQuestion[]
  notificationSent    Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([createdById])
  @@index([industryId])
  @@index([eventId])
  @@index([status])
  @@index([mode])
  @@index([problemType])
  @@index([approvalStatus])
  @@map("problems")
}

model Claim {
  id                Int                @id @default(autoincrement())
  problemId         Int
  problem           Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  teamName          String?
  members           ClaimMember[]
  status            ClaimStatus        @default(IN_PROGRESS)
  submissionUrl     String?
  submissionFileKey String?
  innovationScore   Int?
  technicalScore    Int?
  impactScore       Int?
  uxScore           Int?
  executionScore    Int?
  presentationScore Int?
  feasibilityScore  Int?
  finalScore        Int?
  score             Int?
  feedback          String?            @db.Text
  badges            String?
  isAbsent          Boolean            @default(false)
  reminderSent      Boolean            @default(false)
  mentor            String?            @db.VarChar(200)
  derivedInfo       Json?              // snapshot: { lead: StudentInfo|manual, members: {uid: StudentInfo} }
  venueId           Int?
  venue             Venue?             @relation("ClaimVenue", fields: [venueId], references: [id], onDelete: NoAction)
  presentationScheduledAt DateTime?    // coordinator-set presentation slot for this team
  round2VenueId     Int?
  round2Venue       Venue?             @relation("ClaimRound2Venue", fields: [round2VenueId], references: [id], onDelete: NoAction)
  round2PresentationScheduledAt DateTime?
  tickets           Ticket[]
  attendanceRecords TicketAttendance[]
  rubricScores      RubricScore[]
  sessionDocuments  SessionDocument[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([problemId])
  @@index([status])
  @@index([updatedAt])
  @@map("claims")
}

model ClaimMember {
  id                Int                @id @default(autoincrement())
  claimId           Int
  claim             Claim              @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId            Int
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              String             @default("MEMBER")
  attendanceRecords TicketAttendance[]

  @@unique([claimId, userId])
  @@index([claimId])
  @@index([userId])
  @@map("claim_members")
}

model SessionDocument {
  id               Int      @id @default(autoincrement())
  claimId          Int
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  session          Int
  documentUrl      String?
  documentKey      String
  uploadedByUserId Int
  uploadedBy       User     @relation("SessionDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  uploadedAt       DateTime @default(now())

  @@unique([claimId, session])
  @@index([claimId])
  @@index([session])
  @@index([uploadedAt])
  @@index([uploadedByUserId])
  @@map("session_documents")
}

model HackathonSessionUploadLock {
  id              Int            @id @default(autoincrement())
  eventId         Int
  event           HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session         Int
  isOpen          Boolean        @default(false)
  updatedByUserId Int?
  updatedBy       User?          @relation("SessionUploadLockUpdater", fields: [updatedByUserId], references: [id], onDelete: NoAction)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([eventId, session])
  @@index([eventId])
  @@index([session])
  @@index([updatedByUserId])
  @@map("hackathon_session_upload_locks")
}

model StudentProfile {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       String?       @db.Text
  experience   String?       @db.Text
  interests    String?       @db.Text
  resumeUrl    String?
  isComplete   Boolean       @default(false)
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@map("student_profiles")
}

model FacultyProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   String?
  designation  String?
  expertise    String?  @db.Text
  resumeUrl    String?
  profileLinks Json?
  isComplete   Boolean  @default(false)
  isHod        Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@map("faculty_profiles")
}

model ProblemQuestion {
  id           Int      @id @default(autoincrement())
  problemId    Int
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  questionText String   @db.Text
  type         String   @default("TEXT")
  createdAt    DateTime @default(now())

  answers ApplicationAnswer[]

  @@index([problemId])
  @@map("problem_questions")
}

model Application {
  id        Int                 @id @default(autoincrement())
  userId    Int
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId Int?
  profile   StudentProfile?     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  problemId Int
  problem   Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status    ApplicationStatus   @default(SUBMITTED)
  answers   ApplicationAnswer[]
  feedback  String?             @db.Text
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, problemId])
  @@index([problemId])
  @@index([userId])
  @@index([status])
  @@map("applications")
}

model ApplicationAnswer {
  id            Int             @id @default(autoincrement())
  applicationId Int
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId    Int
  question      ProblemQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText    String          @db.Text

  @@unique([applicationId, questionId])
  @@index([applicationId])
  @@map("application_answers")
}

model InternshipTask {
  id           Int                  @id @default(autoincrement())
  problemId    Int
  problem      Problem              @relation("InternshipProblemTasks", fields: [problemId], references: [id], onDelete: Cascade)
  title        String
  description  String?              @db.Text
  assignedToId Int
  assignedTo   User                 @relation("InternshipTaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  deadline     DateTime?
  status       InternshipTaskStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([problemId, status])
  @@index([assignedToId, status])
  @@map("internship_tasks")
}

model InternshipMessage {
  id        Int      @id @default(autoincrement())
  problemId Int
  problem   Problem  @relation("InternshipProblemMessages", fields: [problemId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User     @relation("InternshipMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([problemId, createdAt])
  @@index([senderId])
  @@map("internship_messages")
}

model InternshipMeeting {
  id                 Int                   @id @default(autoincrement())
  problemId          Int
  problem            Problem               @relation("InternshipProblemMeetings", fields: [problemId], references: [id], onDelete: Cascade)
  title              String
  datetime           DateTime
  link               String
  description        String?               @db.Text
  recurrenceType     MeetingRecurrenceType @default(NONE)
  recurrenceInterval Int                   @default(1)
  recurrenceDay      Int?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([problemId, datetime])
  @@map("internship_meetings")
}

model InternshipDocument {
  id           Int                    @id @default(autoincrement())
  problemId    Int
  problem      Problem                @relation("InternshipProblemDocuments", fields: [problemId], references: [id], onDelete: Cascade)
  fileUrl      String?
  linkUrl      String?
  title        String?
  documentType InternshipDocumentType @default(FILE)
  uploadedById Int
  uploadedBy   User                   @relation("InternshipDocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime               @default(now())

  @@index([problemId, createdAt])
  @@index([uploadedById])
  @@map("internship_documents")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?          @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model HostingRequest {
  id                          Int                           @id @default(autoincrement())
  studentId                   Int
  student                     User                          @relation("HostingRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  projectName                 String
  projectDescription          String                        @db.Text
  githubUrl                   String
  projectCategory             String
  techStack                   Json
  databaseRequired            Boolean                       @default(false)
  databaseType                DatabaseType                  @default(NONE)
  preferredSubdomain          String?
  teamMembers                 String?                       @db.Text
  facultyMentor               String?
  hostingDuration             String?
  additionalNotes             String?                       @db.Text
  adminRemarks                String?                       @db.Text
  status                      HostingRequestStatus          @default(PENDING)
  reviewedById                Int?
  reviewedBy                  User?                         @relation("HostingRequestReviewer", fields: [reviewedById], references: [id], onDelete: NoAction)
  reviewedAt                  DateTime?
  assignedDomain              String?
  coolifyProjectId            String?
  deploymentStatus            String?
  assignedDatabaseCredentials Json?
  hostingExpiryDate           DateTime?
  statusHistory               HostingRequestStatusHistory[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@index([reviewedById])
  @@map("hosting_requests")
}

model HostingRequestStatusHistory {
  id               Int                  @id @default(autoincrement())
  hostingRequestId Int
  hostingRequest   HostingRequest       @relation(fields: [hostingRequestId], references: [id], onDelete: Cascade)
  oldStatus        HostingRequestStatus
  newStatus        HostingRequestStatus
  remarks          String?              @db.Text
  changedById      Int
  changedBy        User                 @relation("HostingRequestStatusChangedBy", fields: [changedById], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())

  @@index([hostingRequestId, createdAt])
  @@index([changedById])
  @@map("hosting_request_status_history")
}

model HackathonEvent {
  id                 Int                          @id @default(autoincrement())
  title              String
  description        String?                      @db.Text
  startTime          DateTime
  endTime            DateTime
  submissionLockAt   DateTime?
  totalSessions      Int                          @default(1)
  registrationOpen   Boolean                      @default(true)
  status             EventStatus                  @default(UPCOMING)
  createdById        Int
  createdBy          User                         @relation("HackathonCreator", fields: [createdById], references: [id], onDelete: Cascade)
  coordinatorId      Int?
  coordinator        User?                        @relation("EventCoordinator", fields: [coordinatorId], references: [id], onDelete: NoAction)
  coordinators       EventCoordinator[]
  problems           Problem[]
  interests          HackathonInterest[]
  sessionUploadLocks HackathonSessionUploadLock[]
  pptFileKey         String?
  departmentId       Int?
  department         Department?                  @relation(fields: [departmentId], references: [id], onDelete: NoAction)
  eventType          String                       @default("hackathon")
  config             Json?
  featured           Boolean                      @default(false)
  rubrics            RubricCategory[]
  venues             Venue[]
  judgeAssignments   JudgeAssignment[]
  notices            Notice[]
  feedback           EventFeedback[]
  media              EventMedia[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  certificates       Certificate[]

  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([createdById])
  @@map("hackathon_events")
}

model Certificate {
  id       Int      @id @default(autoincrement())
  userId   Int
  eventId  Int
  type     String // ACHIEVEMENT | PARTICIPATION
  title    String
  detail   String?
  fileKey  String?
  serial   String   @unique
  issuedAt DateTime @default(now())
  nameOverride String? // admin-corrected name shown on the PDF instead of user.name

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, type])
  @@index([userId])
  @@map("certificates")
}

model HackathonInterest {
  id         Int      @id @default(autoincrement())
  userId     Int
  eventId    Int
  hasDetails Boolean  @default(false)
  teamName   String?
  teamSize   Int?
  createdAt  DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, hasDetails])
  @@index([eventId, createdAt])
  @@map("hackathon_interests")
}

model InnovationProgram {
  id            String   @id @default(cuid())
  title         String
  description   String   @db.Text
  programType   String
  venue         String
  eventDate     DateTime
  startTime     DateTime
  endTime       DateTime
  noticeFileKey String?
  createdById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User              @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: Cascade)
  interests ProgramInterest[]

  @@index([eventDate])
  @@index([createdById])
  @@map("innovation_programs")
}

model ProgramInterest {
  id        String   @id @default(cuid())
  userId    Int
  programId String
  createdAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program InnovationProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([programId, createdAt])
  @@map("program_interests")
}

model Otp {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otps")
}

model Booking {
  id           Int           @id @default(autoincrement())
  studentId    Int
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  purpose      String        @db.Text
  date         DateTime
  timeSlot     String
  facilities   Json
  lab          String
  status       BookingStatus @default(PENDING)
  adminNote    String?       @db.Text
  reminderSent Boolean       @default(false)
  ticket       Ticket?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("bookings")
}

model Ticket {
  id                Int                @id @default(autoincrement())
  ticketId          String             @unique
  type              TicketType
  status            TicketStatus       @default(ACTIVE)
  userId            Int
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId         Int?               @unique
  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: NoAction)
  claimId           Int?
  claim             Claim?             @relation(fields: [claimId], references: [id], onDelete: NoAction)
  title             String
  subjectName       String
  scheduledAt       DateTime?
  pdfObjectKey      String
  qrValue           String
  issuedAt          DateTime           @default(now())
  usedAt            DateTime?
  cancelledAt       DateTime?
  metadata          Json?
  attendanceRecords TicketAttendance[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([claimId, type])
  @@index([userId, status])
  @@index([type, status])
  @@index([issuedAt])
  @@map("tickets")
}

model TicketAttendance {
  id                Int                    @id @default(autoincrement())
  ticketId          Int
  ticket            Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  claimId           Int
  claim             Claim                  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  userId            Int
  user              User                   @relation("AttendanceParticipant", fields: [userId], references: [id], onDelete: Cascade)
  claimMemberId     Int
  claimMember       ClaimMember            @relation(fields: [claimMemberId], references: [id], onDelete: Cascade)
  session           Int                    @default(1)
  status            MemberAttendanceStatus @default(NOT_PRESENT)
  checkedInAt       DateTime?
  checkedInByUserId Int?
  checkedInBy       User?                  @relation("AttendanceMarker", fields: [checkedInByUserId], references: [id], onDelete: NoAction)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([ticketId, claimMemberId, session])
  @@unique([userId, claimId, session])
  @@index([ticketId, session, status])
  @@index([claimMemberId, session, status])
  @@index([claimId, session, status])
  @@index([checkedInByUserId])
  @@map("ticket_attendance")
}

model NewsPost {
  id          Int      @id @default(autoincrement())
  title       String
  caption     String   @db.Text
  imageKey    String
  postedById  Int
  postedBy    User     @relation(fields: [postedById], references: [id], onDelete: Cascade)
  publishedAt DateTime @default(now())
  isVisible   Boolean  @default(true)

  @@map("news_posts")
}

model Grant {
  id            Int           @id @default(autoincrement())
  title         String
  issuingBody   String
  category      GrantCategory
  description   String        @db.Text
  deadline      DateTime
  referenceLink String?
  attachmentKey String?
  postedById    Int
  postedBy      User          @relation(fields: [postedById], references: [id], onDelete: Cascade)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  @@map("grants")
}

model Event {
  id               Int       @id @default(autoincrement())
  title            String
  description      String    @db.Text
  date             DateTime
  mode             EventMode
  registrationLink String?
  posterKey        String?
  postedById       Int
  postedBy         User      @relation(fields: [postedById], references: [id], onDelete: Cascade)
  isVisible        Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@map("events")
}

model ImpersonationSession {
  id              String              @id @default(uuid())
  adminId         Int
  targetUserId    Int
  status          ImpersonationStatus @default(ACTIVE)
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  ipAddress       String?             @db.VarChar(45)
  userAgent       String?             @db.Text
  metadata        Json?

  // Performance indexes
  @@index([adminId, status])
  @@index([adminId, startedAt])
  @@index([targetUserId, startedAt])
  @@index([status, startedAt])
  @@map("impersonation_sessions")
}

model Announcement {
  id          Int      @id @default(autoincrement())
  text        String   @db.Text
  link        String?
  expiresAt   DateTime
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@map("announcements")
}

model HeroSlide {
  id        Int      @id @default(autoincrement())
  title     String
  caption   String   @db.Text
  imageKey  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_slides")
}

model EmailJob {
  id                Int       @id @default(autoincrement())
  toEmail           String
  subject           String
  htmlBody          String    @db.LongText
  category          String
  mode              String    @default("IMMEDIATE")
  status            String    @default("PENDING")
  priority          Int       @default(50)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  lockedAt          DateTime?
  lastError         String?   @db.Text
  providerMessageId String?
  dedupeKey         String?   @unique
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([category])
  @@index([mode])
  @@index([createdAt])
  @@map("email_jobs")
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  hodUserId Int?
  createdAt DateTime @default(now())

  users    User[]
  problems Problem[]
  events   HackathonEvent[]

  @@map("departments")
}

model SiteSetting {
  key         String  @id
  value       Json
  group       String
  label       String
  description String?

  @@index([group])
  @@map("site_settings")
}

model RubricCategory {
  id               Int            @id @default(autoincrement())
  eventId          Int
  event            HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key              String
  label            String
  weight           Int            @default(10)
  order            Int            @default(0)
  isCritical       Boolean        @default(false)
  parentCategoryId Int?
  parentCategory   RubricCategory? @relation("RubricParent", fields: [parentCategoryId], references: [id], onDelete: NoAction)
  childCategories  RubricCategory[] @relation("RubricParent")
  scores           RubricScore[]

  @@unique([eventId, key])
  @@index([eventId])
  @@index([parentCategoryId])
  @@map("rubric_categories")
}

model RubricScore {
  id               Int            @id @default(autoincrement())
  claimId          Int
  claim            Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  rubricCategoryId Int
  rubricCategory   RubricCategory @relation(fields: [rubricCategoryId], references: [id], onDelete: Cascade)
  judgeId          Int              @default(0)
  judge            User?          @relation(fields: [judgeId], references: [id], onDelete: NoAction)
  score            Int
  comment          String?        @db.VarChar(1000)
  round            Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([claimId, rubricCategoryId, round, judgeId])
  @@index([claimId])
  @@index([rubricCategoryId])
  @@index([judgeId])
  @@map("rubric_scores")
}

model Opportunity {
  id                   Int       @id @default(autoincrement())
  title                String
  category             String
  organizer            String
  description          String?   @db.Text
  registrationDeadline DateTime?
  eligibility          String?
  prize                String?
  themes               Json?
  technologies         Json?
  applicationUrl       String?
  facultyRecommended   Boolean   @default(false)
  status               String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdById          Int
  createdBy            User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  interests OpportunityInterest[]

  @@index([status])
  @@index([category])
  @@index([registrationDeadline])
  @@map("opportunities")
}

model OpportunityInterest {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId Int
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        String      @default("SAVED") // SAVED | INTERESTED
  createdAt     DateTime    @default(now())

  @@unique([userId, opportunityId])
  @@map("opportunity_interests")
}

model LearningResource {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  type        String // PDF | LINK | YOUTUBE | GITHUB | TEMPLATE | WINNING_PROJECT
  url         String?
  fileKey     String?
  difficulty  String?
  tags        Json?
  createdById Int
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([type])
  @@map("learning_resources")
}

model AttendanceSnapshot {
  id          Int       @id @default(autoincrement())
  uid         String // ERP ID = "S" + email local part
  subject     String
  type        String // TH | PR | TU
  present     Int
  total       Int
  percentage  Float
  periodStart DateTime? // from report header, when present
  periodEnd   DateTime?
  fetchedAt   DateTime  @default(now())

  @@index([uid])
  @@map("attendance_snapshots")
}

model AttendanceStat {
  id    Int    @id @default(autoincrement())
  key   String @unique // views | refreshes | captcha_asks | password_saves
  value Int    @default(0)

  @@map("attendance_stats")
}

/// Per-user refresh rate-limit state (2 presses / 5 min). One row per student
/// who ever pressed refresh — bounded, no cleanup needed (expired windows
/// reset logically on the next press). Kept OFF the users table on purpose.
model AttendanceRefreshLimit {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  windowStart DateTime
  count       Int      @default(0)

  @@map("attendance_refresh_limits")
}

model AttendanceSyncJob {
  id          Int       @id @default(autoincrement())
  uid         String
  status      String    @default("QUEUED") // QUEUED | RUNNING | AWAITING_CAPTCHA | SUCCESS | FAILED
  attempts    Int       @default(0)
  lastError   String?
  claimantId  String? // worker instance that claimed the job (double-claim guard)
  captchaText String? // human-entered captcha for the two-phase solve
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([uid, status])
  @@map("attendance_sync_jobs")
}

// ── Hackathon ops: venues, judges, notices, feedback, media ──────────────
model EventCoordinator {
  id             Int            @id @default(autoincrement())
  eventId        Int
  event          HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentCode String?        @db.VarChar(32) // null = all departments (global); e.g. "COMP", "AIML"
  createdAt      DateTime       @default(now())

  @@unique([eventId, userId, departmentCode])
  @@index([userId])
  @@index([eventId, departmentCode])
}

model Venue {
  id             Int     @id @default(autoincrement())
  eventId        Int
  event          HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String  @db.VarChar(120)
  capacity       Int?
  order          Int     @default(0)
  departmentCode String? @db.VarChar(32) // null = shared/legacy; e.g. COMP, CIVIL
  claims         Claim[]          @relation("ClaimVenue")
  round2Claims   Claim[]          @relation("ClaimRound2Venue")
  judgeAssignments JudgeAssignment[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([eventId, departmentCode])
  @@map("venues")
}

model JudgeAssignment {
  id        Int     @id @default(autoincrement())
  eventId   Int
  event     HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judgeId   Int
  judge     User    @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  venueId   Int?
  venue     Venue?  @relation(fields: [venueId], references: [id], onDelete: NoAction)

  @@unique([eventId, judgeId])
  @@index([eventId])
  @@index([judgeId])
  @@map("judge_assignments")
}

model Notice {
  id        Int     @id @default(autoincrement())
  eventId   Int
  event     HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String  @db.VarChar(200)
  body      String  @db.Text
  fileKey   String?
  pinned    Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("notices")
}

model EventFeedback {
  id        Int     @id @default(autoincrement())
  eventId   Int
  event     HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String? @db.VarChar(2000)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_feedback")
}

model EventMedia {
  id        Int     @id @default(autoincrement())
  eventId   Int
  event     HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind      String  @db.VarChar(16) // REPORT | PHOTO | VIDEO
  fileKey   String
  caption   String? @db.VarChar(300)
  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("event_media")
}
